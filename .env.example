# Copy this file to .env and fill in your credentials.

# --- IBM watsonx.ai ---
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- NASA Worldview / GIBS ---
# No credentials required — imagery is fetched from public NASA endpoints.
# See: https://worldview.earthdata.nasa.gov/

# --- Copernicus Data Space Ecosystem (Sentinel-2) ---
# Free registration at https://dataspace.copernicus.eu/
# Provides access to Sentinel-2 L2A products at 10 m resolution.
# Leave blank to disable Sentinel-2 fetch (app continues with NASA GIBS only).
CDSE_USER=your_copernicus_email@example.com
CDSE_PASSWORD=your_copernicus_password

# --- Scene Catalogue ---
# Local SQLite database path for the scene catalogue (default: terralens_catalogue.db
# in the project directory).  Override to store the catalogue elsewhere.
# TERRALENS_DB_PATH=/path/to/terralens_catalogue.db

# --- Watsonx.data (optional) ---
# Set this to a JDBC connection URL to mirror every catalogue entry to an
# IBM Watsonx.data (Lakehouse) Iceberg table for enterprise SQL analytics.
# Requires jaydebeapi installed: pip install jaydebeapi
# Leave blank to use local SQLite only.
# WATSONX_DATA_CONNECTION_URL=jdbc:hive2://your-watsonx-host:443/default;...
